/bin/
/dist/
/coverage.out
/.env
/.env.local
/.DS_Store

*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# scratch space for generated docs, demo kits and binary snapshots
/outputs/

# `make man` and `make completions` generate these locally; the release
# pipeline regenerates its own copies and reads neither directory. They are
# build output, not source, and a `git add -A` after either target sweeps
# 300+ files into the commit.
/man/
/completions/

# release-build.sh drops cross-compiled binaries here; only CI publishes them
/npm/cli-*/bin/
/npm/**/node_modules/
*.tgz
/surface-dump

# `orq setup` writes project-scoped agent config into the working directory;
# it is generated, not source.
/.agents/
/.kimi-code/

# Agent config a local `orq setup` writes into whatever directory it runs in.
.mcp.json
.mcp.json.orq-bak

# bartolo >=0.6 writes the generated README next to the hand-written one
# instead of overwriting it; only README.md is source.
README.generated.md
